# Public site URL used for canonical links and OG metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Leave ROADIQ_BACKEND unset to run the complete local/mock product.
# `npx convex dev` writes NEXT_PUBLIC_CONVEX_URL and CONVEX_DEPLOYMENT to .env.local.
# Set ROADIQ_BACKEND=convex only after the Convex deployment has been seeded.
ROADIQ_BACKEND=
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Server/Convex deployment secret. Used by scripts/seed-convex.mjs and Convex seed.importChallenges.
# Never expose it through NEXT_PUBLIC_* or commit a real value.
ROADIQ_SEED_TOKEN=

# Image Factory remains disabled until explicitly enabled. Use the same operator token in
# the Next.js/Vercel environment and the Convex deployment environment. Never expose it client-side.
ROADIQ_IMAGE_FACTORY_ENABLED=0
ROADIQ_IMAGE_FACTORY_TOKEN=
ROADIQ_IMAGE_PROVIDER=goi
ROADIQ_IMAGE_MODEL=gpt-image-2
ROADIQ_IMAGE_QA_MODEL=gemini-3.1-pro

# GOI is used by Convex node actions for both image generation and visual QA.
# Keep the key server-side in the Convex deployment; do not use a NEXT_PUBLIC_* name.
GOI_BASE_URL=https://api.g0i.ai/v1
GOI_API_KEY=

# Convex deployment secret only. Required only when ROADIQ_IMAGE_PROVIDER=gemini.
GEMINI_API_KEY=
