# Public site URL used for canonical links, OG metadata and auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Leave both blank to run the complete local/mock product.
# Create a Supabase project, apply supabase/migrations, enable anonymous sign-ins,
# enable manual identity linking, and then set these values for live mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Operator-only. Use this only with scripts/seed-supabase.mjs.
# Never expose this value through NEXT_PUBLIC_* or commit a real key.
SUPABASE_SERVICE_ROLE_KEY=
